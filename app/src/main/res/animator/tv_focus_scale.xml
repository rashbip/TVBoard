<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Scale up smoothly and elevate like Apple tvOS -->
    <item android:state_focused="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="120"
                android:valueTo="1.12"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="120"
                android:valueTo="1.12"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="120"
                android:valueTo="8dp"
                android:valueType="floatType" />
        </set>
    </item>

    <!-- Normal state: Return to standard scale -->
    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="120"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="120"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="120"
                android:valueTo="0dp"
                android:valueType="floatType" />
        </set>
    </item>
</selector>

