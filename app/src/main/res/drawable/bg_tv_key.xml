<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Apple Pure White keycap (no colored outline stroke) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#007AFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Normal State: Apple tactile 3D keycap with bottom shadow -->
    <item>
        <layer-list>
            <!-- Bottom bevel shadow (tactile depth) -->
            <item android:top="2.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1A1C20" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <!-- Keycap Face -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#5A5E69"
                        android:endColor="#4B4F59" />
                    <corners android:radius="10dp" />
                    <stroke android:width="0.8dp" android:color="#35FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
