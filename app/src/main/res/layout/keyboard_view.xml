<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="bottom|end">

    <LinearLayout
        android:id="@+id/keyboard_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_ios_glass_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <!-- Top Header Bar with Compact Icon Action Buttons and Center Live Text Preview -->
        <LinearLayout
            android:id="@+id/quick_actions_bar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Left Compact Actions -->
            <Button
                style="@style/TvActionKey"
                android:id="@+id/action_lang"
                android:text="EN" />

            <Button
                style="@style/TvActionKey"
                android:id="@+id/action_num"
                android:text="123" />

            <Button
                style="@style/TvActionKey"
                android:id="@+id/action_float"
                android:text="⊡" />

            <!-- Middle Text Preview (Shows live what user is writing) -->
            <TextView
                android:id="@+id/text_preview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:gravity="center_vertical|start"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#E0FFFFFF"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="start"
                android:fontFamily="sans-serif"
                android:background="@drawable/bg_tv_preview" />

            <!-- Right Compact Actions -->
            <Button
                style="@style/TvActionKey"
                android:id="@+id/action_paste"
                android:text="📋"
                android:textSize="13sp" />

            <Button
                style="@style/TvActionKey"
                android:id="@+id/action_clear"
                android:text="⌧"
                android:textSize="14sp" />

            <Button
                style="@style/TvActionKey"
                android:id="@+id/action_hide"
                android:text="✕"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Dynamic Rows Container -->
        <LinearLayout
            android:id="@+id/keys_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical" />

        <!-- Bottom Row: Shift, Space, Backspace, Enter -->
        <LinearLayout
            android:id="@+id/bottom_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="5dp">

            <Button
                style="@style/TvKey"
                android:id="@+id/key_shift"
                android:background="@drawable/bg_tv_modifier_key"
                android:text="⇧"
                android:textSize="17sp"
                android:layout_weight="1.3" />

            <Button
                style="@style/TvKey"
                android:id="@+id/key_space"
                android:text="space"
                android:textSize="15sp"
                android:layout_weight="4.8" />

            <Button
                style="@style/TvKey"
                android:id="@+id/key_backspace"
                android:background="@drawable/bg_tv_modifier_key"
                android:text="⌫"
                android:textSize="16sp"
                android:layout_weight="1.3" />

            <Button
                style="@style/TvKey"
                android:id="@+id/key_enter"
                android:background="@drawable/bg_tv_blue_key"
                android:textColor="@color/color_tv_blue_text"
                android:text="Enter"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_weight="1.8" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
